{
  "name": "devsuoa",
  "version": "0.0.0",
  "private": true,
  "description": "This repository contains the source code for the **DEVS (Developers Society) website**, built with **React, TypeScript, Tailwind CSS, and Vite**.",
  "homepage": "https://github.com/devsuoa/devs-core#readme",
  "bugs": {
    "url": "https://github.com/devsuoa/devs-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devsuoa/devs-core.git"
  },
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d --build --wait api && pnpm --filter @devsuoa/web dev",
    "dev:web": "pnpm --filter @devsuoa/web dev",
    "dev:stop": "docker compose down",
    "build": "pnpm --filter @devsuoa/web build",
    "preview": "pnpm --filter @devsuoa/web preview",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph": "node scripts/dependency-graph.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@viz-js/viz": "^3.31.0",
    "dependency-cruiser": "^18.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,json,md,css,html,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@11.21.0"
}
